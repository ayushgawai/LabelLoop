# copy to .env (gitignored). Loaded by labelloop.config.load_env().
WALLX_ENDPOINT=wss://maas-api.x2robot.com/v1/vla/wallx
WALLX_API_KEY=
# optional: JSON file of extra handshake headers (organizer harness convention)
WALLX_HEADERS_FILE=
# vision agent: any Chat Completions endpoint with image_url support.
# Gemini Robotics-ER via Google's OpenAI-compatible endpoint:
AGENT_CHAT_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
AGENT_MODEL=gemini-robotics-er-1.5-preview
AGENT_API_KEY=
